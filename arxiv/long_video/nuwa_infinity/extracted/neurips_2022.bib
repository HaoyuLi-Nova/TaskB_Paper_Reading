@article{songExplainableVQAExploring,
  title = {Towards Explainable {{VQA}}: {{Exploring Question Intention}} to Answer {{Visual Questions}} with {{External Knowledge}}},
  author = {Song, Lingyun and Li, Jianao and Qian, Buyue and Yang, Yang and Liu, Jun and Shang, Xuequn and Sun, Mingxuan},
  pages = {9},
  abstract = {Visual Question Answering (VQA) has been greatly advanced by deep learning technologies, but still remains an open problem subjected to two aspects of factors. First, previous works mainly focus on the feature fusion of questions and images via attention mechanisms, overlooking the exploration of question intentions such as the location or the functionalities of an object. Second, most of previous works ignore the difference of the abstraction level between the words in questions and the regions in images. For example, when answering questions related to ``electronic devices'', an image region of a phone only captures one instance belonging to the high level category. To address these limitations, we propose an Intention-guided Explainable Visual Question Answering model, called IE-VQA. It mainly has two appealing properties: 1) It can capture question intentions by predicting which aspects of image attributes are relevant to visual questions. By exploring question intentions and external knowledge facts accordant with intentions, IE-VQA is guided to produce higher probability scores for the candidate answers accordant with the intentions. By providing constraints on the prediction results, these knowledge facts can be viewed as explicit explanations for predictions. 2) It reduces the difference of the abstraction level between the words and the image regions, which is helpful in improving the accuracy of the alignments between the words and the image regions. Empirical studies on benchmark datasets show that IE-VQA achieves state-of-the-art performance.},
  langid = {english},
  file = {C\:\\Users\\chewu\\Zotero\\storage\\79HD8EIB\\Song 等。 - Towards explainable VQA Exploring Question Intent.pdf;C\:\\Users\\chewu\\Zotero\\storage\\7XK8NJLE\\7409.txt}
}

