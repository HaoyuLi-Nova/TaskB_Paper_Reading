@article{zhangSpeechBasedVisualQuestion2017,
  title = {Speech-{{Based Visual Question Answering}}},
  author = {Zhang, Ted and Dai, Dengxin and Tuytelaars, Tinne and Moens, Marie-Francine and Van Gool, Luc},
  year = {2017},
  month = may,
  journal = {arXiv:1705.00464 [cs]},
