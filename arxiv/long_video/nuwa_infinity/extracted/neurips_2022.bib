@inproceedings{ganjuWhatQuestionUsing2017,
  title = {What's in a {{Question}}: {{Using Visual Questions}} as a {{Form}} of {{Supervision}}},
  shorttitle = {What's in a {{Question}}},
  booktitle = {{{CVPR}}},
  author = {Ganju, S. and Russakovsky, O. and Gupta, A.},
